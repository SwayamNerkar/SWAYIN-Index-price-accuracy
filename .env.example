# SWAYIN Predictor AI - Environment Variables

# Environment & Server
ENVIRONMENT=production
DEBUG=False
HOST=0.0.0.0
PORT=8000

# Database Configuration (PostgreSQL with SQLite fallback)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/swayin_db
# DATABASE_URL=sqlite+aiosqlite:///backend/swayin.db

# Redis Caching (Optional - automatically falls back to in-memory cache)
REDIS_URL=redis://localhost:6379/0
CACHE_EXPIRE_SECONDS=300

# Google Gemma AI Settings
GEMMA_API_KEY=your_google_gemma_api_key_here
GEMMA_MODEL_NAME=gemma-2-9b-it

# Default Market Data Parameters
DEFAULT_SYMBOL=^NSEI
DEFAULT_INTERVAL=1d
DEFAULT_PERIOD=5y
